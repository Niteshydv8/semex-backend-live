modules = ["nodejs-20", "python-3.12", "web", "bash"]

[nix]
channel = "stable-25_05"

[agent]
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 180000

[workflows]

[[ports]]
localPort = 8099
externalPort = 8099

[[ports]]
localPort = 8899
externalPort = 3000
exposeLocalhost = true

[[ports]]
localPort = 8901
externalPort = 3001

[[ports]]
localPort = 23636
externalPort = 80
