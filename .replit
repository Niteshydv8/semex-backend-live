modules = ["nodejs-20", "python-3.12", "web", "bash"]

[nix]
channel = "stable-25_05"

[agent]
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 180000

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Dashboard Preview"

[[workflows.workflow]]
name = "Dashboard Preview"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd previews/live && python3 -m http.server 5000 --bind 0.0.0.0"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 5000
externalPort = 5000

[[ports]]
localPort = 8099
externalPort = 8099

[[ports]]
localPort = 8899
externalPort = 3000
exposeLocalhost = true

[[ports]]
localPort = 8901
externalPort = 3001

[[ports]]
localPort = 5000
externalPort = 80
